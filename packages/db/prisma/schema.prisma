generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String
  password String
  status   Boolean @default(false)
  automs   Autom[]
}

model Autom {
  id       String     @id @default(uuid())
  userId   String
  actions  Actions[]
  user     User       @relation(fields: [userId], references: [id])
  automRun AutomRun[]
  trigger  Trigger?
}

model Trigger {
  id                 String           @id @default(uuid())
  automId            String           @unique
  availableTriggerId String
  metadata           Json             @default("{}")
  autom              Autom            @relation(fields: [automId], references: [id])
  availableTriggers  AvailableTrigger @relation(fields: [availableTriggerId], references: [id])
}

model AvailableTrigger {
  id       String    @id @default(uuid())
  name     String    @unique
  image    String
  triggers Trigger[]
}

model Actions {
  id               String           @id @default(uuid())
  actionId         String
  automId          String
  sortingOrders    Int              @default(0)
  metadata         Json             @default("{}")
  availableActions AvailableActions @relation(fields: [actionId], references: [id])
  autom            Autom            @relation(fields: [automId], references: [id])
}

model AvailableActions {
  id      String    @id @default(uuid())
  type    String    @unique
  image   String
  actions Actions[]
}

model AutomRun {
  id             String          @id @default(uuid())
  automId        String
  metadata       Json
  autom          Autom           @relation(fields: [automId], references: [id])
  automRunOutbox AutomRunOutbox?
}

model AutomRunOutbox {
  id         String   @id @default(uuid())
  automRunId String   @unique
  automRun   AutomRun @relation(fields: [automRunId], references: [id])
}
