// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String
  password String
  automs   Autom[]
}

model Autom {
  id        String     @id @default(uuid())
  triggerId String
  userId    String
  trigger   Trigger?
  actions   Actions[]
  automRun  AutomRun[]
  user      User       @relation(fields: [userId], references: [id])
}

model Trigger {
  id                 String           @id @default(uuid())
  automId            String           @unique
  availableTriggerId String
  autom              Autom            @relation(fields: [automId], references: [id])
  availableTriggers  AvailableTrigger @relation(fields: [availableTriggerId], references: [id])
}

model AvailableTrigger {
  id       String    @id @default(uuid())
  name     String    @unique
  triggers Trigger[]
}

model Actions {
  id               String           @id @default(uuid())
  actionId         String
  automId          String
  autom            Autom            @relation(fields: [automId], references: [id])
  availableActions AvailableActions @relation(fields: [actionId], references: [id])
  sortingOrders    Int              @default(0)
}

model AvailableActions {
  id      String    @id @default(uuid())
  type    String    @unique
  actions Actions[]
}

model AutomRun {
  id             String          @id @default(uuid())
  automId        String
  metadata       Json
  autom          Autom           @relation(fields: [automId], references: [id])
  automRunOutbox AutomRunOutbox?
}

model AutomRunOutbox {
  id         String   @id @default(uuid())
  automRunId String   @unique
  automRun   AutomRun @relation(fields: [automRunId], references: [id])
}
