{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "lib": ["ESNext"],
    "target": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src"],
  "exclude": ["node_modules","dist"]
}
